# Copy to .env.local, or run `pnpm db:bootstrap`, which creates the databases and writes .env.local for you.
# Every setting is validated in src/lib/env.ts. Safety settings default to the safe value.

# Postgres. Local development uses a dedicated non-superuser role "nabz".
DATABASE_URL=postgres://nabz:<password>@127.0.0.1:5432/nabz_dev
DATABASE_URL_TEST=postgres://nabz:<password>@127.0.0.1:5432/nabz_test


# Who can be called.
#   testing: only the numbers in ALLOWED_NUMBERS can be added or called (comma-separated).
#   production: any valid number. Needs a premium Bolna API key, because trial accounts only reach verified numbers.
NABZ_MODE=testing
ALLOWED_NUMBERS=

# Calling safety. Calling stays off unless this is exactly "true". Applies in both modes.
CALLING_ENABLED=false
BOLNA_DAILY_SPEND_CAP_USD=10


# Bolna. Required when CALLING_ENABLED=true, and by the agents:create, agents:sync and calls:sync commands.
BOLNA_API_KEY=
